# =============================================================================
# MODÈLE DE CONFIGURATION ENVIRONNEMENT BÊTA PUBLIQUE — SWITCH BÉNIN
# Fichier : .env.example.beta (AUCUN SECRET RÉEL NE DOIT ÊTRE INSCRIT ICI)
# =============================================================================

# Paramètres Réseau et Hôte
NODE_ENV=production
PORT=4148
HOST=127.0.0.1

# Domaine et Origines Autorisées
PUBLIC_DOMAIN=TO_BE_PROVIDED_BY_OWNER
PUBLIC_API_ORIGIN=TO_BE_DERIVED_FROM_PUBLIC_DOMAIN
ALLOWED_ORIGINS=https://TO_BE_PROVIDED_BY_OWNER

# Mode Financier Bêta (Verrouillage Obligatoire)
REAL_MONEY_DISABLED=true
VISA_DISABLED=true
SBEE_DISABLED=true
PAYOUTS_DISABLED=true
QR_PAYMENT_DISABLED=true
DEMO_MODE=true

# Stockage et Journalisation
STORAGE_DRIVER=json_isolated
STORAGE_FILE=scratch/preprod_storage.json
LOG_LEVEL=info
BACKUP_LOCATION=TO_BE_PROVIDED_BY_OWNER
